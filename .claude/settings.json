{
  "hooks": {
    "FileChanged": [
      {
        "matcher": "notes/",
        "hooks": [
          {
            "type": "command",
            "command": "$j = $input | ConvertFrom-Json; if ($j.file_path -match 'notes/') { exit 2 } else { exit 0 }",
            "shell": "powershell",
            "asyncRewake": true,
            "rewakeMessage": "A file was saved in notes/. Please run /daily-wrapup now to update today's wrap-up log.",
            "rewakeSummary": "notes/ file changed — daily wrap-up triggered",
            "statusMessage": "Checking notes/ for changes..."
          }
        ]
      }
    ]
  }
}
